{
  "name": "page-pulse",
  "version": "1.0.0",
  "description": "Analyzes a web page's HTML and reports audit findings (SEO, performance, accessibility, etc).",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build": "npm install --prefix client && npm run build --prefix client && node scripts/verify-build.js",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/client/"
    ]
  },
  "keywords": [
    "audit",
    "html",
    "express"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "jest": "^30.4.2"
  }
}
